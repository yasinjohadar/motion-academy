# Environment for the docker-compose stack.
#
#   cp .env.docker.example .env
#   docker compose run --rm app php artisan key:generate
#   docker compose up -d
#   docker compose exec app php artisan migrate --force
#
# The values that differ from a local .env are the hostnames: inside the network a
# service is reached by its compose service name, never 127.0.0.1.

APP_NAME="Laravel Starter"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# `mysql` is the compose service name, not localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Redis is in the stack, so cache, sessions and the queue all move off the database.
# The queue especially: the database driver polls, Redis does not.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
STORAGE_FALLBACK_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
