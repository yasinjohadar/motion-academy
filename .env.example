APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Rotation: laravel/whatsapp/integrations keep 14 days; browser logs are
# high-volume dev noise so they keep 3.
LOG_DAILY_DAYS=14
LOG_BROWSER_DAYS=3

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_MYSQLDUMP_PATH=
BACKUP_JOB_TIMEOUT=3600
BACKUP_STUCK_RUNNING_MINUTES=120
# true = تشغيل النسخ/الاسترجاع فوراً بدون php artisan queue:work
BACKUP_DISPATCH_SYNC=false

# Laravel AI SDK (config/ai.php) — set the provider(s) you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
JINA_API_KEY=
VOYAGEAI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_URL=http://localhost:11434
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=

VITE_APP_NAME="${APP_NAME}"

# Real-time notifications (Reverb). Keep NOTIFICATIONS_REALTIME=false until
# `php artisan reverb:start` runs as a supervised daemon; the UI then falls back
# to polling every NOTIFICATIONS_POLL_INTERVAL milliseconds.
NOTIFICATIONS_REALTIME=false
NOTIFICATIONS_POLL_INTERVAL=30000
NOTIFICATIONS_RETENTION_READ_DAYS=30
NOTIFICATIONS_RETENTION_UNREAD_DAYS=180

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public hostname clients connect to (the domain, not the internal bind address).
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Address/port the reverb:start process binds to on the server.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Web Push (browser notifications). Generate with `php artisan webpush:vapid`.
# VAPID_SUBJECT identifies this app to push services and is required.
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
