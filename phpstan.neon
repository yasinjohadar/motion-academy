includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    # Pinned at the highest level that is currently clean, and raised deliberately.
    #
    # Measured after the model typing pass: level 3 = 0 - level 4 = 39 - level 5 = 47
    # - level 6 = 231. It started at level 1, with level 2 showing 50 findings.
    #
    # Setting it to 6 today would mean 231 findings nobody triages, and a tool everyone
    # learns to ignore is worse than no tool. A gate that passes is a gate that can fail
    # meaningfully.
    #
    # The climb to level 4 is 39 findings, mostly missing generics on collections and
    # array shapes on service return values. Fix them, then raise this number.
    level: 3

    # Factories legitimately hand partial attribute arrays to models.
    excludePaths:
        - app/Modules/*/Database/Factories/*
